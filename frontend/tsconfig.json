{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/pages/canvas/project": ["src/overrides/pages/canvas/project.tsx"],
      "@/pages/assets": ["src/overrides/pages/assets/index.tsx"],
      "@/components/canvas/asset-picker-modal": ["src/overrides/components/canvas/asset-picker-modal.tsx"],
      "@/components/canvas/canvas-side-panel": ["src/overrides/components/canvas/canvas-side-panel.tsx"],
      "@/components/canvas/canvas-top-bar": ["src/overrides/components/canvas/canvas-top-bar.tsx"],
      "@/components/canvas/canvas-prompt-chip-input": ["src/overrides/components/canvas/canvas-prompt-chip-input.tsx"],
      "@/i18n/locales/en-US": ["src/overrides/i18n/locales/en-US.ts"],
      "@/i18n/locales/zh-CN": ["src/overrides/i18n/locales/zh-CN.ts"],
      "@/stores/canvas/use-canvas-store": ["src/adapters/use-canvas-store.ts"],
      "@/stores/use-canvas-side-panel-store": ["src/overrides/stores/use-canvas-side-panel-store.ts"],
      "@/stores/use-config-store": ["src/adapters/use-config-store.ts"],
      "@/stores/use-asset-store": ["src/adapters/use-asset-store.ts"],
      "@/services/image-storage": ["src/adapters/image-storage.ts"],
      "@/services/api/image": ["src/adapters/image-api.ts"],
      "@/services/api/video": ["src/adapters/video-api.ts"],
      "@/services/api/audio": ["src/adapters/audio-api.ts"],
      "@/lib/canvas/plugin-loader": ["src/adapters/plugin-loader.ts"],
      "@/lib/canvas/plugin-registry": ["src/adapters/plugin-registry.ts"],
      "@/lib/canvas/canvas-generation-helpers": ["src/adapters/canvas-generation-helpers.ts"],
      "@/services/file-storage": ["src/adapters/file-storage.ts"],
      "@/*": ["src/upstream/*"],
      "@sub2api/*": ["src/*"]
    },
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "src/entry.tsx",
    "src/standalone.tsx",
    "src/vite-env.d.ts",
    "src/host-context.tsx",
    "src/api/**/*.ts",
    "src/stores/**/*.ts",
    "src/jobs/**/*.ts",
    "src/components/**/*.tsx",
    "src/editor/**/*.ts",
    "src/editor/**/*.tsx",
    "src/runtime/**/*.ts",
    "src/adapters/**/*.ts",
    "src/overrides/**/*.ts",
    "src/overrides/**/*.tsx",
    "src/i18n.tsx",
    "src/upstream/components/canvas/infinite-canvas.tsx",
    "src/upstream/lib/canvas-theme.ts",
    "src/upstream/stores/use-theme-store.ts",
    "src/upstream/types/canvas.ts"
  ]
}
